# Frontend environment variables
#
# Copy this file to .env.local for local development:
#   cp frontend/.env.example frontend/.env.local
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the client bundle at
# build time, so changing one requires a rebuild. All values here are examples.

# ---------------------------------------------------------------------------
# API base URL (required)
# ---------------------------------------------------------------------------
# Base URL of the ManageHub backend API. Every frontend API module
# (lib/auth-api.ts, lib/admin-api.ts, lib/payments-api.ts, lib/wallet-api.ts,
# lib/credits-api.ts) builds its request URLs from this value.
#
# The default below matches the backend's configured port (PORT=6100 in
# backend/.env.example). Unset in development the app falls back to
# http://localhost:6100 (see lib/env.ts). Production builds MUST set this
# variable explicitly; there is no production default.
NEXT_PUBLIC_API_URL=http://localhost:6100

# ---------------------------------------------------------------------------
# Public app origin
# ---------------------------------------------------------------------------
# Canonical origin of this frontend, used for metadataBase (app/layout.tsx),
# robots.txt (app/robots.ts) and the sitemap (app/sitemap.ts). Defaults to
# https://managehub.app when unset.
NEXT_PUBLIC_APP_URL=https://managehub.app

# ---------------------------------------------------------------------------
# Sentry
# ---------------------------------------------------------------------------
# Error and performance monitoring. The DSN enables Sentry; without it the
# SDK stays inert. See SENTRY_SETUP.md for the full walkthrough.
NEXT_PUBLIC_SENTRY_DSN=
# Environment label reported to Sentry; defaults to NODE_ENV when unset.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Sample rates between 0 and 1 (defaults live in sentry.client.config.ts).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=

# ---------------------------------------------------------------------------
# Search engine verification
# ---------------------------------------------------------------------------
# Google site verification meta tag rendered by app/layout.tsx metadata.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ---------------------------------------------------------------------------
# Server-only variables
# ---------------------------------------------------------------------------
# Secret used by middleware.ts to verify the session cookie's JWT signature
# with jose. Keep this aligned with the backend's JWT_SECRET. Never expose
# this variable under the NEXT_PUBLIC_ prefix.
JWT_SECRET=

# Set to true to opt into the Next bundle analyzer with:
#   npm run build:analyze
ANALYZE=false
